# The foundation runs entirely against the simulated provider and needs no keys.
# Add live-provider credentials only after documenting current pricing, confirming
# that paid billing is disabled, and adding the provider to the eligibility policy.

# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Gateway resilience settings
GATEWAY_INTERACTIVE_TIMEOUT_SECONDS=2.0
GATEWAY_DEFERRABLE_TIMEOUT_SECONDS=10.0
GATEWAY_ATTEMPT_BUDGET=1
GATEWAY_BREAKER_ERROR_THRESHOLD=0.5
GATEWAY_LATENCY_BUDGET_MS=1000
